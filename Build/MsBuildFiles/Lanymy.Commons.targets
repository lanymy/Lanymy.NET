<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--MSBuild 是 Visual Studio 的生成系统。 可通过以下链接查看包含 MSBuild 参考信息的主题-->
  <!--https://docs.microsoft.com/zh-cn/visualstudio/msbuild/msbuild-reference?view=vs-2019-->

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\imgs\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>



  <PropertyGroup>
    <!--<OutputPath>bin\Debug\</OutputPath>-->
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' != ''">
    <LanymyLegacyProjectReferenceTargetFramework Condition="'$(LanymyLegacyProjectReferenceTargetFramework)' == '' and $([System.String]::Copy('$(TargetFrameworks)').Contains('netstandard2.1'))">netstandard2.1</LanymyLegacyProjectReferenceTargetFramework>
  </PropertyGroup>

  <!--
    Xamarin 旧式项目在解析多目标 SDK 项目引用时，会直接请求 GetTargetPath。
    对于外层 cross-targeting build，这个目标默认不存在，因此这里转发到兼容性最好的 netstandard2.1 内层构建。
  -->
  <Target Name="GetTargetPath"
          Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' != '' and '$(LanymyLegacyProjectReferenceTargetFramework)' != ''"
          Returns="@(_LanymyLegacyProjectTargetPath)">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="GetTargetPath"
             Properties="TargetFramework=$(LanymyLegacyProjectReferenceTargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_LanymyLegacyProjectTargetPath" />
    </MSBuild>
  </Target>


  <!--<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netcoreapp2.2|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\netcoreapp2.2\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netcoreapp2.2|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\netcoreapp2.2\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net48|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\net48\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net48|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\net48\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\netstandard2.0\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.0|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\netstandard2.0\$(CurrentBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>-->


</Project>
